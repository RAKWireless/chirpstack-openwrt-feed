#!/bin/sh /etc/rc.common

START=99
STOP=99

USE_PROCD=1
CHIPSET=
PACKAGE_NAME="chirpstack-concentratord-slot2"

configuration() {
	. /lib/functions/chirpstack-concentratord.sh
	configure "$PACKAGE_NAME"
}

start_service() {
    [ "$(uci get $PACKAGE_NAME.@global[0].enabled)" != "1" ] && return 1

	configuration

	procd_open_instance 
	procd_set_param command /usr/bin/chirpstack-concentratord-$CHIPSET -c /var/etc/$PACKAGE_NAME/concentratord.toml -c /var/etc/$PACKAGE_NAME/region.toml -c /var/etc/$PACKAGE_NAME/channels.toml
	procd_set_param respawn 3600 5 -1
	procd_set_param file /etc/config/$PACKAGE_NAME
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$PACKAGE_NAME"
}

reload_service() {
	stop
	start
}

# RAK7391: D3 status LED tracks "any concentratord slot up". sysfs path is
# only present when the rak7391 device-tree overlay is applied — silently
# no-op otherwise so this file stays portable across boards.
#
# Timing notes:
#   - service_started fires before procd actually forks the daemon, and
#     stop_service fires before procd has killed it (procd_kill is async).
#     Both hooks run a short delay in the background so the pidof check
#     reflects post-transition state.
#   - service_stopped is not invoked for short-lived init scripts (the
#     script exits before the ubus event arrives), so the stop path is
#     wired through stop_service instead.
STATUS_LED=/sys/class/leds/rak7391:green:status/brightness

update_status_led() {
	[ -w "$STATUS_LED" ] || return 0
	if pidof chirpstack-concentratord-sx1301 \
	         chirpstack-concentratord-sx1302 \
	         chirpstack-concentratord-2g4 >/dev/null 2>&1; then
		echo 1 > "$STATUS_LED"
	else
		echo 0 > "$STATUS_LED"
	fi
}

service_started() {
	( sleep 2 && update_status_led ) &
}

stop_service() {
	( sleep 2 && update_status_led ) &
}
