#!/bin/sh /etc/rc.common

START=99
STOP=99

USE_PROCD=1
CHIPSET=
PACKAGE_NAME="chirpstack-concentratord-slot2"

configuration() {
	. /lib/functions/chirpstack-concentratord.sh
	configure "$PACKAGE_NAME"
}

start_service() {
    [ "$(uci get $PACKAGE_NAME.@global[0].enabled)" != "1" ] && return 1

	configuration

	procd_open_instance 
	procd_set_param command /usr/bin/chirpstack-concentratord-$CHIPSET -c /var/etc/$PACKAGE_NAME/concentratord.toml -c /var/etc/$PACKAGE_NAME/region.toml -c /var/etc/$PACKAGE_NAME/channels.toml
	procd_set_param respawn 3600 5 -1
	procd_set_param file /etc/config/$PACKAGE_NAME
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$PACKAGE_NAME"
}

reload_service() {
	stop
	start
}

# RAK7393: slot2 drives its own LoRa2 LED directly from this script's
# lifecycle, instead of a process scan. A raw pidof/grep can't tell slot1
# and slot2 apart (both run identically-named binaries, and a grep over
# /proc/*/cmdline matches its own invocation too) — per plan + review
# 2026-07-15. sysfs path is only present when the rak7393 device-tree
# overlay is applied; the writability guard keeps this file portable to
# boards without it.
LORA_LED=/sys/class/leds/rak7393:green:lora2/brightness

service_started() {
	[ -w "$LORA_LED" ] || return 0
	[ "$(uci -q get $PACKAGE_NAME.@global[0].enabled)" = "1" ] || return 0
	echo 1 > "$LORA_LED"
}

stop_service() {
	[ -w "$LORA_LED" ] || return 0
	echo 0 > "$LORA_LED"
}
